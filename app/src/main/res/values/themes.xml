<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CalendarEventSnooze"
           parent="Theme.MaterialComponents.DayNight.NoActionBar" />
    <style name="Theme.CalendarEventSnooze.Alarm"
           parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- M3.1 — must match AlarmBackground in Color.kt, or the takeover
             flashes the old colour before Compose draws. -->
        <item name="android:windowBackground">#0D1209</item>
        <!--
          NOTE: android:windowShowWhenLocked / android:windowTurnScreenOn were
          removed here because they fail resource linking under this AGP/AAPT2
          combination ("attribute not found"). The behaviour is preserved via the
          manifest (android:showOnLockScreen / android:turnScreenOn on the
          activity) and programmatically in AlarmActivity.onCreate() via
          setShowWhenLocked(true) / setTurnScreenOn(true).
        -->
    </style>
</resources>
