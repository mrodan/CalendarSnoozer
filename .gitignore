# --- Gradle ---
.gradle/
build/
**/build/

# --- Android Studio / IntelliJ ---
.idea/
*.iml
captures/
.externalNativeBuild/
.cxx/

# --- Machine-specific SDK config (regenerated automatically on each machine) ---
local.properties

# --- Signing keys / secrets (never commit these) ---
*.jks
*.keystore
# Holds the keystore passwords, so it matters as much as the .jks itself.
keystore.properties

# --- OS / misc ---
.DS_Store
*.log

# Keep the Gradle wrapper jar (needed to run ./gradlew after cloning)
!gradle/wrapper/gradle-wrapper.jar
